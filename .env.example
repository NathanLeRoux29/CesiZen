# Base de données MySQL
# En local (sans Docker) : DB_HOST=localhost
# Avec Docker : DB_HOST=mysql (nom du service dans docker-compose)
DB_HOST=mysql
DB_ROOT_PASSWORD=rootpassword_change_me
DB_USER=cesizen_user
DB_PASSWORD=password_change_me
DB_NAME=cesizen

# Backend
JWT_SECRET=jwt_secret_change_me_in_production
JWT_EXPIRES_IN=24h
NODE_ENV=production

# Frontend / Backoffice (URL de l'API accessible depuis le navigateur)
VITE_API_URL=http://localhost:3001
